{
  "manifest_version": 3,
  "name": "X Enhancement Suite",
  "version": "0.5.1",
  "description": "Experimental (dev mode only) Chrome extension for personal X DOM enhancements.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "X Enhancement Suite",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*"
      ],
      "css": [
        "src/content/content.css"
      ],
      "js": [
        "src/shared/settings.js",
        "src/shared/dom-rules.js",
        "src/content/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
